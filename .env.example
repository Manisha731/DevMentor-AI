# GitHub OAuth App (Phase 2)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NVIDIA NIM (free key from build.nvidia.com)
NVIDIA_API_KEY=

# Infrastructure
DATABASE_URL=postgresql://devmentor:devmentor@localhost:5433/devmentor
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Models (config, not code, because the NVIDIA catalog changes)
PLANNER_AGENT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
REVIEW_AGENT_MODEL=qwen/qwen3-coder-480b-a35b-instruct
MENTOR_AGENT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Agent limits (validated at startup in Phase 7)
REVIEW_AGENT_MAX_ITERATIONS=5
REVIEW_AGENT_MAX_ITERATIONS_PER_TASK=3
MENTOR_AGENT_MAX_ITERATIONS=3
PLANNER_BIG_COMMIT_FILES=3
PLANNER_BIG_COMMIT_LINES=150
PLANNER_MAX_SPLIT_TASKS=3
PLANNER_MAX_FOLLOWUP_ROUNDS=1
REVIEW_SIDE_MAX_CALLS_PER_COMMIT=12

# Secrets generated locally (Phase 2)
TOKEN_ENCRYPTION_KEY=

# Auth (Phase 2)
SESSION_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8001/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user public_repo

# Polling (Phase 4)
POLL_ENABLED=true
POLL_INTERVAL_MINUTES=5
POLL_INITIAL_COMMITS=5
